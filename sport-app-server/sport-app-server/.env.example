# Пример файла .env

# База данных
POSTGRES_DB=your-database-name
POSTGRES_USER=user
POSTGRES_PASSWORD=your-very-strong-password
POSTGRES_HOST=localhost
EXTRA_PARAMS=SearchPath=public

# JWT
JWT_SECRET_KEY=your_super_secret_key_here_at_least_32_chars
JWT_ISSUER=sport-app
JWT_AUDIENCE=sport-app-users
JWT_EXPIRATION_MINUTES=60